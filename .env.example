# Welora Telegram Bot Configuration
# Copy this file to .env and fill in your actual values.

# Your Telegram API ID from my.telegram.org
TELEGRAM_API_ID=37729457

# Your Telegram API Hash from my.telegram.org
TELEGRAM_API_HASH=bb68973b7efcbbd074cda984c95502d6

# Your Bot Token received from @BotFather
TELEGRAM_BOT_TOKEN=123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ

# Comma-separated list of Telegram user IDs for Bot Administrators
BOT_ADMIN_IDS=7777777,9999999

# SQLite database file path
DATABASE_PATH=bot_database.db

# Number of messages required to trigger a random character spawn in a group chat
SPAWN_INTERVAL=100
